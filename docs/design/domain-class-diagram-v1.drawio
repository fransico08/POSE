        <mxCell id="HandoverRequest" value="&lt;div style=&quot;padding:8px 10px;background:#E9EEF4;color:#162435;font-size:17px&quot;&gt;&lt;b&gt;HandoverRequest&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding:3px 10px;color:#52677D;font-size:12px&quot;&gt;&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;/div&gt;&lt;div style=&quot;padding:6px 10px;font-family:monospace;font-size:12px;border-top:1px solid #B7C4D1&quot;&gt;- id: UUID&lt;br&gt;- type: HandoverType&lt;br&gt;- reason: String&lt;br&gt;- status: HandoverStatus&lt;br&gt;- requestedById: UUID&lt;br&gt;- targetUserId: UUID?&lt;br&gt;- reviewedById: UUID?&lt;br&gt;- reviewedAt: Instant?&lt;br&gt;- rejectionReason: String?&lt;/div&gt;&lt;div style=&quot;padding:6px 10px;font-family:monospace;font-size:12px;border-top:1px solid #B7C4D1&quot;&gt;+ submit(): void&lt;br&gt;+ approve(target): void&lt;br&gt;+ reject(reason): void&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=0;fillColor=#FFFFFF;strokeColor=#68809A;strokeWidth=1.7;shadow=0;overflow=fill;" vertex="1" parent="1">

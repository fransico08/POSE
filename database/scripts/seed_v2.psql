\set ON_ERROR_STOP on
\echo '== POSE CRM W12 canonical seed =='
BEGIN;
SET TIME ZONE 'Asia/Ho_Chi_Minh';
DO $$
BEGIN
  IF current_database() NOT IN ('pose_w12_v12_final_test', 'pose_w12_v12_clean_test', 'pose_w12_v12_canonical_test') THEN
    RAISE EXCEPTION 'Seed aborted: expected an isolated canonical V12 test database, got %.', current_database();
  END IF;
  IF EXISTS (SELECT 1 FROM organizations LIMIT 1) THEN
    RAISE EXCEPTION 'Seed aborted: target database is not empty. Use a fresh database or run reset_demo_v2.psql only on a disposable local/demo DB.';
  END IF;
END $$;
-- Stage các bảng có thể xung đột với dữ liệu do migration tạo trước seed.
CREATE TEMP TABLE w12_stage_permissions (LIKE public.permissions INCLUDING DEFAULTS) ON COMMIT DROP;
CREATE TEMP TABLE w12_stage_role_permissions (LIKE public.role_permissions) ON COMMIT DROP;
CREATE TEMP TABLE w12_stage_opportunities (LIKE public.opportunities INCLUDING DEFAULTS) ON COMMIT DROP;
\copy organizations (id,name,industry,status,metadata,created_at,updated_at,code) FROM 'database/data/seed/multisector_v2/organizations.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy departments (id,organization_id,code,name,status,created_at) FROM 'database/data/seed/multisector_v2/departments.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy w12_stage_permissions (id,code,description,created_at) FROM 'database/data/seed/multisector_v2/permissions.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
DO $$
DECLARE
  permitted_conflicts int;
  unexpected_code_conflicts int;
  id_conflicts int;
BEGIN
  SELECT count(*) INTO permitted_conflicts
  FROM w12_stage_permissions s
  JOIN public.permissions p ON p.code = s.code
  WHERE s.code = 'sales_assignment.manage'
    AND s.id = '670272d2-66ab-5e93-83ce-6cefb05cb617'::uuid
    AND p.id = '7c4500c4-9b38-4a5c-92de-27d8d9b00124'::uuid;

  SELECT count(*) INTO unexpected_code_conflicts
  FROM w12_stage_permissions s
  JOIN public.permissions p ON p.code = s.code
  WHERE s.code <> 'sales_assignment.manage';

  SELECT count(*) INTO id_conflicts
  FROM w12_stage_permissions s
  JOIN public.permissions p ON p.id = s.id;

  IF permitted_conflicts <> 1 OR unexpected_code_conflicts <> 0 OR id_conflicts <> 0 THEN
    RAISE EXCEPTION 'Migration permission conflict is not the approved sales_assignment.manage mapping.';
  END IF;
END $$;
INSERT INTO public.permissions (id, code, description, created_at)
SELECT s.id, s.code, s.description, s.created_at
FROM w12_stage_permissions s
WHERE s.code <> 'sales_assignment.manage';
\copy roles (id,organization_id,code,display_name,description,status,created_at) FROM 'database/data/seed/multisector_v2/roles.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy users (id,organization_id,full_name,status,metadata,created_at,updated_at,email,normalized_email,archived_at) FROM 'database/data/seed/multisector_v2/users.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy credentials (user_id,password_hash,password_changed_at,failed_login_count,updated_at) FROM 'database/data/seed/multisector_v2/credentials.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy teams (id,organization_id,code,name,description,manager_user_id,status,created_at,updated_at,department_id) FROM 'database/data/seed/multisector_v2/teams.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy team_memberships (id,organization_id,team_id,user_id,joined_at,left_at,status) FROM 'database/data/seed/multisector_v2/team_memberships.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy user_role_grants (id,organization_id,user_id,role_id,granted_by_user_id,granted_at,revoked_at) FROM 'database/data/seed/multisector_v2/user_role_grants.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy w12_stage_role_permissions (role_id,permission_id,granted_at) FROM 'database/data/seed/multisector_v2/role_permissions.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
DO $$
DECLARE
  legacy_reference_count int;
  existing_role_permissions int;
BEGIN
  SELECT count(*) INTO legacy_reference_count
  FROM w12_stage_role_permissions
  WHERE permission_id = '670272d2-66ab-5e93-83ce-6cefb05cb617'::uuid;

  SELECT count(*) INTO existing_role_permissions
  FROM public.role_permissions;

  IF legacy_reference_count <> 12 OR existing_role_permissions <> 0 THEN
    RAISE EXCEPTION 'Role permission migration state is unsafe: legacy=% existing=%', legacy_reference_count, existing_role_permissions;
  END IF;
END $$;
INSERT INTO public.role_permissions (role_id, permission_id, granted_at)
SELECT
  s.role_id,
  CASE
    WHEN s.permission_id = '670272d2-66ab-5e93-83ce-6cefb05cb617'::uuid
      THEN '7c4500c4-9b38-4a5c-92de-27d8d9b00124'::uuid
    ELSE s.permission_id
  END,
  s.granted_at
FROM w12_stage_role_permissions s;
DO $$
DECLARE
  migration_permissions int;
  sales_assignment_grants int;
  unexpected_new_grants int;
BEGIN
  SELECT count(*) INTO migration_permissions
  FROM public.permissions
  WHERE (id, code) IN (
    ('d2193c90-06cc-4a3c-b90d-b03912921ebc'::uuid, 'offering.read'),
    ('7c4500c4-9b38-4a5c-92de-27d8d9b00124'::uuid, 'sales_assignment.manage'),
    ('27fdd389-32da-46d9-94e5-120000000001'::uuid, 'ai.assist.use'),
    ('27fdd389-32da-46d9-94e5-120000000002'::uuid, 'ai.signal.review'),
    ('27fdd389-32da-46d9-94e5-120000000003'::uuid, 'ai.admin'),
    ('27fdd389-32da-46d9-94e5-120000000004'::uuid, 'ai.metrics.read')
  );

  SELECT count(*) INTO sales_assignment_grants
  FROM public.role_permissions rp
  JOIN public.permissions p ON p.id = rp.permission_id
  WHERE p.code = 'sales_assignment.manage';

  SELECT count(*) INTO unexpected_new_grants
  FROM public.role_permissions rp
  JOIN public.permissions p ON p.id = rp.permission_id
  WHERE p.code IN ('offering.read','ai.assist.use','ai.signal.review','ai.admin','ai.metrics.read');

  IF migration_permissions <> 6 OR sales_assignment_grants <> 12 OR unexpected_new_grants <> 0 THEN
    RAISE EXCEPTION 'Migration permission reconciliation failed.';
  END IF;
END $$;
-- Bổ sung các grant V5/V12 không thể được migration tạo trước khi roles tồn tại.
INSERT INTO public.role_permissions (role_id, permission_id, granted_at)
SELECT r.id, p.id, CURRENT_TIMESTAMP
FROM public.roles r
CROSS JOIN public.permissions p
WHERE (p.code = 'offering.read' AND r.code = 'SALES_REP' AND r.status = 'ACTIVE')
   OR (p.code = 'ai.assist.use' AND r.status = 'ACTIVE' AND r.code IN ('ADMIN','MANAGER','SALES_REP','CUSTOMER_CARE'))
   OR (p.code = 'ai.signal.review' AND r.status = 'ACTIVE' AND r.code IN ('MANAGER','SALES_REP','CUSTOMER_CARE'))
   OR (p.code = 'ai.admin' AND r.status = 'ACTIVE' AND r.code = 'ADMIN')
   OR (p.code = 'ai.metrics.read' AND r.status = 'ACTIVE' AND r.code IN ('ADMIN','DATA_STAFF'));
\copy offering_categories (id,organization_id,code,name,description,status,created_at,updated_at) FROM 'database/data/seed/multisector_v2/offering_categories.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy offerings (id,organization_id,category_id,code,name,description,kind,unit,status,metadata,created_at,updated_at) FROM 'database/data/seed/multisector_v2/offerings.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
-- Áp dụng lại V8 sau khi offerings và teams đã tồn tại trong seed.
UPDATE public.offerings o
SET team_id = (
  SELECT t.id
  FROM public.teams t
  WHERE t.organization_id = o.organization_id
    AND t.code = 'SALES'
    AND t.status = 'ACTIVE'
)
WHERE o.team_id IS NULL
  AND EXISTS (
    SELECT 1
    FROM public.teams t
    WHERE t.organization_id = o.organization_id
      AND t.code = 'SALES'
      AND t.status = 'ACTIVE'
  );
\copy offering_attribute_definitions (id,organization_id,category_id,key,label,value_type,required,validation_rule,options,sort_order,status) FROM 'database/data/seed/multisector_v2/offering_attribute_definitions.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy offering_attribute_values (id,organization_id,offering_id,attribute_definition_id,value_json,created_at,updated_at) FROM 'database/data/seed/multisector_v2/offering_attribute_values.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy offering_prices (id,organization_id,offering_id,amount,currency_code,pricing_unit,effective_from,effective_to,created_at) FROM 'database/data/seed/multisector_v2/offering_prices.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy sales_assignments (id,organization_id,offering_id,sales_user_id,assigned_by_user_id,status,effective_from,effective_to,revoked_at,revoke_reason,created_at,updated_at) FROM 'database/data/seed/multisector_v2/sales_assignments.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (effective_to,revoked_at,revoke_reason), ENCODING 'UTF8');
\copy source_systems (id,organization_id,code,name,source_type,status,metadata,created_at,updated_at) FROM 'database/data/seed/multisector_v2/source_systems.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy customers (id,organization_id,owner_user_id,display_name,email,normalized_email,phone,normalized_phone,status,metadata,created_at,archived_at,updated_at,customer_type,address,notes,related_offering_id) FROM 'database/data/seed/multisector_v2/customers.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (email,normalized_email,phone,normalized_phone,archived_at,customer_type,address,notes,related_offering_id), ENCODING 'UTF8');
\copy leads (id,organization_id,owner_user_id,offering_id,display_name,email,normalized_email,phone,normalized_phone,status,qualified_at,converted_customer_id,converted_at,disqualification_reason,created_at,archived_at,updated_at,source,notes) FROM 'database/data/seed/multisector_v2/leads.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (email,normalized_email,phone,normalized_phone,qualified_at,converted_customer_id,converted_at,disqualification_reason,archived_at,source,notes), ENCODING 'UTF8');
\copy source_record_links (id,organization_id,source_system_id,subject_type,subject_id,external_id,source_entity_type,status,linked_at) FROM 'database/data/seed/multisector_v2/source_record_links.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy duplicate_review_cases (id,organization_id,subject_type,subject_id,candidate_type,candidate_id,match_reason,status,reviewed_by_user_id,reviewed_at,created_at) FROM 'database/data/seed/multisector_v2/duplicate_review_cases.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy w12_stage_opportunities (id,organization_id,customer_id,lead_id,offering_id,owner_user_id,title,stage,expected_value,currency_code,expected_close_date,closing_reason,closed_at,created_at,updated_at,final_value,actual_close_date,notes) FROM 'database/data/seed/multisector_v2/opportunities.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (customer_id,lead_id,expected_value,expected_close_date,closing_reason,closed_at,final_value,actual_close_date,notes), ENCODING 'UTF8');
-- Hoàn nguyên đúng phép dẫn xuất V10 cho 18 opportunity V2 cũ chưa có field mới.
INSERT INTO public.opportunities (
  id, organization_id, customer_id, lead_id, offering_id, owner_user_id,
  title, stage, expected_value, currency_code, expected_close_date,
  closing_reason, closed_at, created_at, updated_at, final_value,
  actual_close_date, notes
)
SELECT
  s.id,
  s.organization_id,
  s.customer_id,
  s.lead_id,
  s.offering_id,
  s.owner_user_id,
  s.title,
  s.stage,
  s.expected_value,
  s.currency_code,
  s.expected_close_date,
  s.closing_reason,
  s.closed_at,
  s.created_at,
  s.updated_at,
  CASE
    WHEN s.stage = 'WON' AND s.final_value IS NULL THEN s.expected_value
    ELSE s.final_value
  END,
  CASE
    WHEN s.stage = 'WON' AND s.actual_close_date IS NULL
      THEN CAST(s.closed_at AT TIME ZONE 'Asia/Ho_Chi_Minh' AS DATE)
    ELSE s.actual_close_date
  END,
  s.notes
FROM w12_stage_opportunities s;
DO $$
DECLARE
  existing_lines int;
BEGIN
  SELECT count(*) INTO existing_lines FROM public.opportunity_lines;
  IF existing_lines <> 0 THEN
    RAISE EXCEPTION 'Unexpected opportunity_lines before V10 replay: %', existing_lines;
  END IF;
END $$;
INSERT INTO public.opportunity_lines (
  id, organization_id, opportunity_id, offering_id, position, quantity,
  unit_price, discount_amount, line_total, created_at, updated_at
)
SELECT
  o.id,
  o.organization_id,
  o.id,
  o.offering_id,
  1,
  1,
  COALESCE(o.expected_value, 0),
  0,
  COALESCE(o.expected_value, 0),
  o.created_at,
  o.updated_at
FROM public.opportunities o;
\copy handover_requests (id,organization_id,customer_id,handover_type,requested_by_user_id,target_user_id,reason,status,reviewed_by_user_id,reviewed_at,rejection_reason,created_at,updated_at) FROM 'database/data/seed/multisector_v2/handover_requests.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (target_user_id,reviewed_by_user_id,reviewed_at,rejection_reason), ENCODING 'UTF8');
\copy customer_assignments (id,organization_id,customer_id,user_id,assignment_type,effective_from,effective_to,status,assigned_by_user_id,source,handover_request_id,created_at) FROM 'database/data/seed/multisector_v2/customer_assignments.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (effective_to,handover_request_id), ENCODING 'UTF8');
\copy interactions (id,organization_id,customer_id,lead_id,opportunity_id,recorded_by_user_id,type,channel,subject,content,outcome,visibility,occurred_at,created_at,updated_at) FROM 'database/data/seed/multisector_v2/interactions.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (customer_id,lead_id,opportunity_id,outcome), ENCODING 'UTF8');
\copy feedbacks (id,organization_id,customer_id,lead_id,recorded_by_user_id,category,content,rating,visibility,received_at,created_at) FROM 'database/data/seed/multisector_v2/feedbacks.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (customer_id,lead_id,rating), ENCODING 'UTF8');
\copy crm_tasks (id,organization_id,customer_id,lead_id,opportunity_id,owner_user_id,created_by_user_id,title,description,priority,status,due_at,result,origin,idempotency_key,completed_at,created_at,updated_at,cancellation_reason) FROM 'database/data/seed/multisector_v2/crm_tasks.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (customer_id,lead_id,opportunity_id,description,result,idempotency_key,completed_at,cancellation_reason), ENCODING 'UTF8');
\copy import_jobs (id,organization_id,source_system_id,submitted_by_user_id,approved_by_user_id,status,original_file_ref,original_filename,file_checksum,idempotency_key,retry_count,total_rows,valid_rows,error_rows,submitted_at,validated_at,approved_at,committed_at,failure_reason) FROM 'database/data/seed/multisector_v2/import_jobs.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy import_rows (id,organization_id,import_job_id,row_number,raw_payload,normalized_payload,status,error_codes,duplicate_candidate,committed_entity_type,committed_entity_id,row_fingerprint,created_at) FROM 'database/data/seed/multisector_v2/import_rows.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy import_decisions (id,organization_id,import_job_id,decision,decided_by_user_id,decided_at,reason) FROM 'database/data/seed/multisector_v2/import_decisions.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy audit_logs (id,organization_id,actor_user_id,action,entity_type,entity_id,before_data,after_data,safe_metadata,result,occurred_at) FROM 'database/data/seed/multisector_v2/audit_logs.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy outbox_events (id,organization_id,aggregate_type,aggregate_id,event_type,payload,idempotency_key,delivery_status,retry_count,last_error,occurred_at,published_at) FROM 'database/data/seed/multisector_v2/outbox_events.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy workflow_executions (id,organization_id,outbox_event_id,workflow_type,idempotency_key,status,retry_count,last_error,started_at,finished_at,created_task_id) FROM 'database/data/seed/multisector_v2/workflow_executions.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
\copy support_requests (id,organization_id,customer_id,assigned_to_user_id,title,category,description,priority,status,escalation_reason,resolution,created_at,updated_at,resolved_at,closed_at) FROM 'database/data/seed/multisector_v2/support_requests.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (escalation_reason,resolution,resolved_at,closed_at), ENCODING 'UTF8');
\copy support_responses (id,organization_id,support_request_id,content,status_after,created_by_user_id,created_at) FROM 'database/data/seed/multisector_v2/support_responses.csv' WITH (FORMAT csv, HEADER true, NULL '', FORCE_NULL (status_after), ENCODING 'UTF8');
\copy support_attachments (id,organization_id,support_request_id,support_response_id,file_name,file_type,file_size,storage_ref,uploaded_by_user_id,uploaded_at) FROM 'database/data/seed/multisector_v2/support_attachments.csv' WITH (FORMAT csv, HEADER true, NULL '', ENCODING 'UTF8');
COMMIT;
\echo '== Seed v2 loaded. Run verify_seed_v2.psql next. =='
